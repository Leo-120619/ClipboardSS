<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap desktop rescap">
  <Identity Name="ClipboardSS" Publisher="CN=ClipboardSS Development" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>ClipboardSS</DisplayName>
    <PublisherDisplayName>ClipboardSS</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="ClipboardSS" Executable="ClipboardSS.App.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="ClipboardSS" Description="ClipboardSS secure clipboard companion"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Send files with ClipboardSS">
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="ClipboardSS.App.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ClipboardSSStartup" Enabled="false" DisplayName="ClipboardSS" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
