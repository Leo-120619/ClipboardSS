<Window x:Class="ClipboardSS.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ClipboardSS.App.UI"
        Title="ClipboardSS" Width="720" Height="680" MinWidth="560" MinHeight="520"
        WindowStartupLocation="Manual" WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip"
        Topmost="True" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="White" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SegmentBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" />
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="ClipboardSS" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource HeaderActionButton}" ToolTip="Manage paired devices"
                            AutomationProperties.Name="Devices" Click="Devices_OnClick">
                        <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                    </Button>
                    <Button Style="{StaticResource HeaderActionButton}" ToolTip="Select text anywhere on screen"
                            AutomationProperties.Name="Screen Text" Click="ScreenText_OnClick">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                    </Button>
                    <Button Style="{StaticResource HeaderActionButton}" ToolTip="Capture a screen region"
                            AutomationProperties.Name="Screenshot" Click="Screenshot_OnClick">
                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                    </Button>
                    <Button Style="{StaticResource HeaderActionButton}" ToolTip="Open preferences"
                            AutomationProperties.Name="Preferences" Click="Preferences_OnClick">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Margin="0,14,0,0" Padding="10" CornerRadius="9"
                    Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 FontSize="14" VerticalContentAlignment="Center"
                                 ToolTip="Search clip text" AutomationProperties.Name="Search clips"
                                 TextChanged="SearchBox_OnTextChanged"
                                 PreviewMouseDown="SearchBox_OnPreviewMouseDown"
                                 LostKeyboardFocus="SearchBox_OnLostKeyboardFocus" />
                    </Grid>
                    <Border Grid.Column="1" Padding="3" CornerRadius="8" Background="#FFE6E9EE">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AllFilter" Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="All" Tag="All" IsChecked="True" Checked="Filter_OnChecked" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="Text" Tag="Text" Checked="Filter_OnChecked" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="Images" Tag="Image" Checked="Filter_OnChecked" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="Pinned" Tag="Pinned" Checked="Filter_OnChecked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="ErrorBanner" Margin="0,10,0,0" Padding="10,7" CornerRadius="6"
                    Background="#FFFFE8E6" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

        <Grid Grid.Row="2">
            <ListBox x:Name="ClipList" Margin="16,12,16,6" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="2,8,0,8" Text="{Binding Name}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ui:ClipCardControl Item="{Binding Clip}" IsProminent="{Binding IsProminent}"
                                            Store="{Binding DataContext.Store, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CopyRequested="Card_OnCopyRequested"
                                            PinRequested="Card_OnPinRequested"
                                            DeleteRequested="Card_OnDeleteRequested"
                                            SinglePasteRequested="Card_OnSinglePasteRequested"
                                            DoublePasteRequested="Card_OnDoublePasteRequested" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="360" Visibility="Collapsed">
                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,0" Text="No matching clips" FontSize="18"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Margin="0,7,0,0" Text="Copy text or images anywhere in Windows and they’ll appear here."
                           Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
