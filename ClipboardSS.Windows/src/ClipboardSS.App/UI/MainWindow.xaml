<ui:FluentWindow x:Class="ClipboardSS.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:ClipboardSS.App.UI"
        Title="ClipboardSS" Width="720" Height="680" MinWidth="560" MinHeight="520"
        WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip"
        Topmost="True" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        AllowDrop="True" DragOver="Window_OnDragOver" Drop="Window_OnDrop">
    <ui:FluentWindow.Resources>
        <Style x:Key="SegmentButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ClipboardSS" />

        <StackPanel Grid.Row="1" Margin="16,0,16,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                        <ui:SymbolIcon Symbol="Clipboard24" Foreground="White" FontSize="18" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ClipboardSS" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Transparent" Margin="2,0" ToolTip="Manage paired devices" Click="Devices_OnClick">
                        <ui:SymbolIcon Symbol="Phone24" FontSize="20" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Margin="2,0" ToolTip="Select text anywhere on screen" Click="ScreenText_OnClick">
                        <ui:SymbolIcon Symbol="TextT24" FontSize="20" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Margin="2,0" ToolTip="Capture a screen region" Click="Screenshot_OnClick">
                        <ui:SymbolIcon Symbol="Camera24" FontSize="20" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Margin="2,0" ToolTip="Open preferences" Click="Preferences_OnClick">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="20" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Border Margin="0,14,0,0" Padding="10" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ui:TextBox x:Name="SearchBox" Grid.Column="0" IconPlacement="Left" PlaceholderText="Search clips..."
                                FontSize="14" Margin="0,0,10,0"
                                TextChanged="SearchBox_OnTextChanged"
                                PreviewMouseDown="SearchBox_OnPreviewMouseDown"
                                LostKeyboardFocus="SearchBox_OnLostKeyboardFocus" />
                    
                    <Border Grid.Column="1" Padding="4" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AllFilter" Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="All" Tag="All" IsChecked="True" Checked="Filter_OnChecked" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="Text" Tag="Text" Checked="Filter_OnChecked" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="Images" Tag="Image" Checked="Filter_OnChecked" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="Pinned" Tag="Pinned" Checked="Filter_OnChecked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <Border x:Name="ErrorBanner" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Row="3">
            <ListBox x:Name="ClipList" Margin="16,12,16,6" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="2,8,0,8" Text="{Binding Name}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <app:ClipCardControl Item="{Binding Clip}" IsProminent="{Binding IsProminent}"
                                            Store="{Binding DataContext.Store, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CopyRequested="Card_OnCopyRequested"
                                            PinRequested="Card_OnPinRequested"
                                            DeleteRequested="Card_OnDeleteRequested"
                                            SinglePasteRequested="Card_OnSinglePasteRequested"
                                            DoublePasteRequested="Card_OnDoublePasteRequested" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="360" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Clipboard24" FontSize="48" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,16,0,0" Text="No matching clips" FontSize="20"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Margin="0,8,0,0" Text="Copy text or images anywhere in Windows and they’ll appear here."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" FontSize="14" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
