<ui:FluentWindow x:Class="ClipboardSS.App.UI.DevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ClipboardSS Devices" Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <ui:TitleBar Grid.Row="0" Title="ClipboardSS Devices" />
        
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Devices" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            
            <StackPanel Grid.Row="1" Margin="0,18,0,0" Orientation="Horizontal">
                <ui:Button Width="120" Content="Show Code" Appearance="Primary" Click="ShowCode_OnClick" />
                <TextBlock x:Name="HostCodeText" Margin="18,3,0,0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
            
            <StackPanel Grid.Row="2" Margin="0,18,0,0" Orientation="Horizontal">
                <ui:TextBox x:Name="JoinCodeText" Width="160" MaxLength="6" FontSize="18" PlaceholderText="Code" />
                <ui:Button x:Name="JoinButton" Margin="10,0,0,0" Width="100" Content="Enter Code"
                        Click="Join_OnClick" />
            </StackPanel>
            
            <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,10,0,10" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
                    
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
            <ListBox x:Name="PairedList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="12" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Content="Send file" Tag="{Binding Id}" Margin="0,0,8,0" Click="SendFile_OnClick" />
                                    <ui:Button Content="Unpair" Tag="{Binding Id}" Appearance="Danger" Click="Unpair_OnClick" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="16" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Host}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
              <TextBlock Margin="0,8,0,6" Text="Transfers" FontWeight="SemiBold" />
              <ListBox x:Name="TransferList" MaxHeight="130" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,3">
                  <ui:Button DockPanel.Dock="Right" Content="Cancel" Tag="{Binding TransferId}" Click="CancelTransfer_OnClick" />
                  <StackPanel><TextBlock Text="{Binding FileName}" /><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"><Run Text="{Binding Status}" /><Run Text=" — " /><Run Text="{Binding BytesTransferred}" /><Run Text=" / " /><Run Text="{Binding TotalBytes}" /></TextBlock></StackPanel>
                </DockPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              </StackPanel>
            </ScrollViewer>
            
            <TextBlock Grid.Row="5" Margin="0,14,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                    Text="Pairing codes expire after 180 seconds. If discovery misses a device, ClipboardSS automatically scans the local /24 subnet." />
        </Grid>
    </Grid>
</ui:FluentWindow>
