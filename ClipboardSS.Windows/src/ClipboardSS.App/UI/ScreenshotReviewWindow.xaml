<Window x:Class="ClipboardSS.App.UI.ScreenshotReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot Text" Width="900" Height="620" MinWidth="660" MinHeight="440"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="18,15">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton" Margin="0,0,8,0" MinWidth="130" Height="36"
                        Content="Copy Selection" Click="Copy_OnClick" />
                <Button MinWidth="80" Height="36" Content="Done" IsCancel="True" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Screenshot Text" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="SelectionSummary" Margin="0,3,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
        <Grid Grid.Row="2" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border Background="#10000000" CornerRadius="8" Padding="8">
                <Image x:Name="ScreenshotImage" Stretch="Uniform" />
            </Border>
            <Border Grid.Column="1" Margin="16,0" Background="{DynamicResource BorderBrush}" />
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Recognized Text" FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyText" Margin="0,8,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Button x:Name="LanguageSettingsButton" Margin="0,0,0,10" Height="32"
                            Content="Open language settings" Click="LanguageSettings_OnClick" />
                </StackPanel>
                <ListBox x:Name="BlocksList" SelectionMode="Multiple" DisplayMemberPath="Text"
                         SelectionChanged="BlocksList_OnSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="9,7" />
                            <Setter Property="Margin" Value="0,0,0,5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
