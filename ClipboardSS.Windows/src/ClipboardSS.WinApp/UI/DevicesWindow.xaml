<ui:FluentWindow x:Class="ClipboardSS.App.UI.DevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ClipboardSS Devices" Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <ui:TitleBar Grid.Row="0" Title="ClipboardSS Devices" />
        
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Devices" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <StackPanel x:Name="HostingPanel" Orientation="Horizontal">
                    <ui:Button Width="120" Content="Show Code" Appearance="Primary" Click="ShowCode_OnClick" />
                    <TextBlock x:Name="HostCodeText" Margin="18,3,0,0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <!-- Pairing v2: both device names and the 6-digit number, confirmed on both screens. -->
                <StackPanel x:Name="ComparisonPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ComparisonNamesText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ComparisonHintText" Margin="0,4,0,0" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ComparisonCodeText" Margin="0,6,0,6" FontSize="48" FontWeight="Bold" FontFamily="Consolas"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ComparisonWaitingText" Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Width="120" Content="Cancel" Click="CancelComparison_OnClick" />
                        <ui:Button x:Name="ConfirmComparisonButton" Margin="10,0,0,0" Width="160" Content="Numbers match"
                                Appearance="Primary" Click="ConfirmComparison_OnClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="JoinPanel" Grid.Row="2" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="PeerPicker" Width="270" ToolTip="The device to pair with" />
                    <ui:Button x:Name="ScanButton" Margin="10,0,0,0" Width="130" Content="Scan network" Click="Scan_OnClick" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <ui:TextBox x:Name="JoinCodeText" Width="160" MaxLength="6" FontSize="18" PlaceholderText="Code" />
                    <ui:Button x:Name="JoinButton" Margin="10,0,0,0" Width="100" Content="Enter Code"
                            Click="Join_OnClick" />
                </StackPanel>
            </StackPanel>
            
            <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,10,0,10" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
                    
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
            <ListBox x:Name="PairedList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="12" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Content="{Binding ConnectActionLabel}" Tag="{Binding Id}" Margin="0,0,8,0" Click="ToggleConnected_OnClick" />
                                    <ui:Button Content="Send file" Tag="{Binding Id}" Margin="0,0,8,0" Click="SendFile_OnClick" IsEnabled="{Binding CanSend}" />
                                    <ui:Button Content="Unpair" Tag="{Binding Id}" Appearance="Danger" Click="Unpair_OnClick" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="16" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text=" · " />
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Host}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
              <TextBlock Margin="0,8,0,6" Text="Transfers" FontWeight="SemiBold" />
              <ListBox x:Name="TransferList" MaxHeight="130" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,3">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="Open location" Tag="{Binding SavedPath}" Margin="0,0,8,0" Click="OpenLocation_OnClick">
                      <ui:Button.Style>
                        <Style TargetType="ui:Button">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="Cancel" Tag="{Binding TransferId}" Click="CancelTransfer_OnClick" />
                  </StackPanel>
                  <StackPanel><TextBlock Text="{Binding FileName}" /><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"><Run Text="{Binding Status}" /><Run Text=" — " /><Run Text="{Binding BytesTransferred}" /><Run Text=" / " /><Run Text="{Binding TotalBytes}" /></TextBlock></StackPanel>
                </DockPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              </StackPanel>
            </ScrollViewer>
            
            <TextBlock Grid.Row="5" Margin="0,14,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                    Text="Pairing codes expire after 180 seconds. Pick the device to pair with; if it is missing, use Scan network to search the local subnet." />
        </Grid>
    </Grid>
</ui:FluentWindow>
