<ui:FluentWindow x:Class="ClipboardSS.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:ClipboardSS.App.UI"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="ClipboardSS" Width="720" Height="680" MinWidth="560" MinHeight="520"
        WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip"
        Topmost="True" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        AllowDrop="True" DragOver="Window_OnDragOver" Drop="Window_OnDrop">
    <ui:FluentWindow.Resources>
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Appearance" Value="Secondary" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16">
            <!-- The header doubles as the title bar: drag it to move the window. -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Logo.png" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,28,28" RadiusX="6" RadiusY="6" />
                        </Image.Clip>
                    </Image>
                    <TextBlock Margin="10,0,0,0" Text="ClipboardSS" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="StatusText" Margin="10,2,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Style="{StaticResource HeaderButton}" ToolTip="Devices" Click="Devices_OnClick"
                               automation:AutomationProperties.Name="Devices">
                        <ui:SymbolIcon Symbol="PhoneLaptop24" FontSize="18" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource HeaderButton}" ToolTip="Screen Text" Click="ScreenText_OnClick"
                               automation:AutomationProperties.Name="Screen Text">
                        <ui:SymbolIcon Symbol="ScanText24" FontSize="18" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource HeaderButton}" ToolTip="Screenshot" Click="Screenshot_OnClick"
                               automation:AutomationProperties.Name="Screenshot">
                        <ui:SymbolIcon Symbol="ScanCamera24" FontSize="18" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource HeaderButton}" ToolTip="Preferences" Click="Preferences_OnClick"
                               automation:AutomationProperties.Name="Preferences">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource HeaderButton}" ToolTip="Close ClipboardSS" Click="Close_OnClick"
                               automation:AutomationProperties.Name="Close ClipboardSS">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Border Margin="0,12,0,0" Padding="10" CornerRadius="8"
                    Background="{DynamicResource ClipCardBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Symbol="Search24" FontSize="18" VerticalAlignment="Center" Margin="2,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="SearchPlaceholder" Text="Search clips" FontSize="14"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBox x:Name="SearchBox" FontSize="14" Background="Transparent" BorderThickness="0"
                                 Padding="0" VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                 Style="{x:Null}"
                                 automation:AutomationProperties.Name="Search clips"
                                 TextChanged="SearchBox_OnTextChanged"
                                 PreviewMouseDown="SearchBox_OnPreviewMouseDown"
                                 LostKeyboardFocus="SearchBox_OnLostKeyboardFocus" />
                    </Grid>

                    <Border Grid.Column="2" Padding="2" CornerRadius="8" Background="{DynamicResource ClipCardBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AllFilter" Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="All" Tag="All" IsChecked="True" Checked="Filter_OnChecked" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="Text" Tag="Text" Checked="Filter_OnChecked" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="Images" Tag="Image" Checked="Filter_OnChecked" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filters"
                                         Content="Pinned" Tag="Pinned" Checked="Filter_OnChecked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ErrorBanner" Margin="0,10,0,0" Padding="10,4,4,4" CornerRadius="6"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" Visibility="Collapsed">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" BorderThickness="0" Width="28" Height="28"
                               Padding="0" VerticalAlignment="Top" ToolTip="Dismiss" Click="DismissError_OnClick"
                               automation:AutomationProperties.Name="Dismiss error">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                    </ui:Button>
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Row="2">
            <ListBox x:Name="ClipList" Margin="16,8,2,6" Padding="0" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <!-- The stock template indents the cards past their section header. -->
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel>
                                                <ContentPresenter />
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,8,0,8" Text="{Binding Name}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <!-- A bare container: the card draws itself, with no selection or hover chrome. -->
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <app:ClipCardControl Item="{Binding Clip}" IsProminent="{Binding IsProminent}"
                                            Store="{Binding DataContext.Store, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CopyRequested="Card_OnCopyRequested"
                                            PinRequested="Card_OnPinRequested"
                                            DeleteRequested="Card_OnDeleteRequested"
                                            SinglePasteRequested="Card_OnSinglePasteRequested"
                                            DoublePasteRequested="Card_OnDoublePasteRequested" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="360" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="MailInbox24" FontSize="44" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,0" Text="No matching clips" FontSize="16"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Margin="0,6,0,0" Text="Copy text or images anywhere on your PC and they will appear here."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" FontSize="13" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
