<UserControl x:Class="ClipboardSS.App.UI.ClipCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="False">
    <ui:Card x:Name="CardBorder" Margin="0,0,0,10" Padding="12"
             Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
             BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <Border Width="34" Height="34" CornerRadius="7" VerticalAlignment="Top"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ui:SymbolIcon x:Name="TypeGlyph" Symbol="Clipboard24" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>

            <Grid x:Name="ContentHitArea" Grid.Column="1" Margin="8,0,12,0"
                  Focusable="True" Cursor="Hand"
                  MouseLeftButtonUp="Content_OnMouseLeftButtonUp"
                  KeyDown="Content_OnKeyDown"
                  automation:AutomationProperties.HelpText="Press Enter to copy this clip">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Border x:Name="PinnedBadge" DockPanel.Dock="Right" Margin="8,0,0,0"
                                Padding="8,4" CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Visibility="Collapsed">
                            <TextBlock Text="Pinned" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        </Border>
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" ClipToBounds="True"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" LineHeight="20" FontSize="14" />
                    </DockPanel>
                    <Border x:Name="ImageContainer" Margin="0,10,0,0" MaxHeight="150"
                            CornerRadius="7" ClipToBounds="True" Visibility="Collapsed"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Image x:Name="ThumbnailImage" Stretch="Uniform" MaxHeight="150"
                               automation:AutomationProperties.Name="Clipboard image preview" />
                    </Border>
                    <TextBlock x:Name="MetadataText" Margin="0,8,0,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Width="48" Height="40" Margin="0,0,6,0" Content="Copy" Appearance="Secondary"
                        ToolTip="Copy clip" Click="Copy_OnClick"
                        automation:AutomationProperties.Name="Copy clip" />
                <ui:Button x:Name="PinButton" Width="48" Height="40" Margin="0,0,6,0" Content="Pin" Appearance="Secondary"
                        ToolTip="Pin clip" Click="Pin_OnClick"
                        automation:AutomationProperties.Name="Pin clip" />
                <ui:Button Width="56" Height="40" Content="Delete" Appearance="Danger"
                        ToolTip="Delete clip" Click="Delete_OnClick"
                        automation:AutomationProperties.Name="Delete clip" />
            </StackPanel>
        </Grid>
    </ui:Card>
</UserControl>
