<ui:FluentWindow x:Class="ClipboardSS.App.UI.ScreenshotReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Screenshot Text" Width="900" Height="620" MinWidth="660" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <ui:TitleBar Grid.Row="0" Title="Screenshot Text" />
        
        <DockPanel Grid.Row="1" Margin="18,15">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="CopyButton" Margin="0,0,8,0" MinWidth="130" Height="36" Appearance="Primary"
                        Content="Copy Selection" Click="Copy_OnClick" />
                <ui:Button MinWidth="80" Height="36" Content="Done" IsCancel="True" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Screenshot Text" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="SelectionSummary" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>
        
        <Border Grid.Row="2" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        
        <Grid Grid.Row="3" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Image x:Name="ScreenshotImage" Stretch="Uniform" />
            </Border>
            
            <Border Grid.Column="1" Margin="16,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Recognized Text" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="EmptyText" Margin="0,8,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button x:Name="LanguageSettingsButton" Margin="0,0,0,10" Height="32"
                            Content="Open language settings" Click="LanguageSettings_OnClick" />
                </StackPanel>
                <ListBox x:Name="BlocksList" SelectionMode="Multiple" DisplayMemberPath="Text"
                         SelectionChanged="BlocksList_OnSelectionChanged" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="9,7" />
                            <Setter Property="Margin" Value="0,0,0,5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
